[Unit]
Description=Quant Studio (量化分析工作台)
After=network.target

[Service]
# 应用目录与虚拟环境（deploy.sh 会自动创建 /opt/quant-app/venv）
WorkingDirectory=/opt/quant-app
ExecStart=/opt/quant-app/venv/bin/python3 app.py --host 0.0.0.0 --port 8000 --no-browser
Restart=always
RestartSec=3
# 个人服务器用 root 即可；如需加固可改为独立用户并授权 /opt/quant-app
User=root
Group=root

[Install]
WantedBy=multi-user.target
